# Generated Kennel native installer. Modules retain their reviewed import boundaries.
installer_modules := {"scripts/install.kujo":["from src.bootstrap import bootstrap_main","try { bootstrap_main(args()) } except err { print(\"Kennel installer: \" + to_string(err)); exit(1) }",""],"src/bootstrap.kujo":["from src.global_common import global_link, global_present, global_no_links, global_directory, global_home, global_delete, global_capture, global_runtime, global_owned, global_options, global_contains","from src.utils import dict_get_or, shell_quote, ensure_dir","from src.registry_transport import registry_json, registry_blob","from src.registry_protocol import registry_validate_version, registry_valid_version","from src.registry_archive import extract_registry_archive","","func bootstrap_download(version, target) {","    mut origin := \"https://kennel.kujolang.ai\"","    if version == \"\" { version = dict_get_or(registry_json(origin + \"/api/v1/packages/kennel.json\"), \"latest\", \"\") }","    if type(version) != \"string\" || registry_valid_version(version) == false { throw(\"Invalid or unavailable Kennel release version\") }","    mut url := origin + \"/api/v1/packages/kennel/\" + version + \".json\"","    mut doc := registry_validate_version(registry_json(url), \"kennel\", url)","    mut archive := registry_blob(doc[\"archive_url\"], doc[\"archive_sha256\"], 8388608)","    mut provenance := registry_blob(doc[\"provenance_url\"], doc[\"provenance_sha256\"], 1048576)","    return bootstrap_install_release(doc, archive, provenance, target)","}","export func bootstrap_install_release(doc, archive, provenance_bytes, target) {","    mut origin := \"https://kennel.kujolang.ai\"","    mut version := dict_get_or(doc, \"version\", \"\")","    registry_validate_version(doc, \"kennel\", origin + \"/api/v1/packages/kennel/\" + version + \".json\")","    if doc[\"repository\"] != \"kujolang/kennel\" || doc[\"repository_id\"] != 1264528549 || doc[\"scope\"] != null || doc[\"official\"] != true { throw(\"Invalid official Kennel release identity\") }","    if doc[\"source_tag\"] != version && doc[\"source_tag\"] != \"v\" + version { throw(\"Malformed official release tag\") }","    if len(archive) != doc[\"archive_size\"] { throw(\"Kennel archive size mismatch\") }","    if sha256(archive) != doc[\"archive_sha256\"] || sha256(provenance_bytes) != doc[\"provenance_sha256\"] { throw(\"Kennel release checksum mismatch\") }","    mut provenance := parse_json(decode_charset(provenance_bytes, \"utf-8\", 1048576))","    if type(provenance) != \"dict\" || dict_get_or(provenance, \"schema_version\", 0) != 1 || starts_with(dict_get_or(provenance, \"workflow_run\", \"\"), \"https://github.com/kujolang/kennel-registry/actions/runs/\") == false { throw(\"Invalid official publishing workflow provenance\") }","    mut workflow_sha := dict_get_or(provenance, \"workflow_sha\", \"\")","    if len(workflow_sha) != 40 { throw(\"Invalid publishing workflow SHA\") }","    for ch in split(workflow_sha, \"\") { if index_of(\"0123456789abcdef\", ch) < 0 { throw(\"Invalid publishing workflow SHA\") } }","    for key in [\"package\", \"version\", \"source_commit\", \"source_tag\", \"repository\", \"repository_id\", \"release_id\", \"archive_sha256\"] {","        if dict_get_or(provenance, key, null) != doc[key] { throw(\"Kennel provenance identity mismatch: \" + key) }","    }","    os_rmdir(target)","    extract_registry_archive(archive, target, doc[\"file_count\"])","    return {\"version\": version, \"archive_sha256\": doc[\"archive_sha256\"], \"registry\": origin}","}","func bootstrap_source(source, target) {","    for relative in [\"kennel.kujo\", \"kennel.toml\", \"bin/kennel\", \"scripts/tool_manager.kujo\", \"scripts/bootstrap.json\"] {","        if path_is_file(source + \"/\" + relative) == false { throw(\"Not an installable Kennel checkout: \" + relative) }","    }","    mut names := split(global_capture([\"git\", \"-C\", source, \"ls-files\", \"-z\"], {}), decode_charset(bytes([0]), \"utf-8\", 1))","    for name in names {","        if name == \"\" { continue }","        mut excluded := false","        for part in split(name, \"/\") { if global_contains([\".git\", \".kennel_tmp\", \"kennel_packages\", \"node_modules\"], part) { excluded = true } }","        if excluded { continue }","        mut path := source + \"/\" + name","        global_no_links(path)","        if path_is_file(path) {","            mut dest := target + \"/\" + name; ensure_dir(dirname(dest)); copy_file(path, dest)","            mut mode := 420","            if bit_and(io_file_metadata(path)[\"mode\"], 73) != 0 { mode = 493 }","            io_set_permissions(dest, mode)","        }","    }","    return {\"source\": source, \"review_build\": true}","}","export func bootstrap_profiles(base, user_home) {","    mut environment := base + \"/env\"","    global_no_links(environment)","    mut text := \"# Kennel PATH\\ncase \\\":$\" + \"{PATH:-}:\\\" in *\" + shell_quote(\":\" + base + \"/bin:\") + \"*) ;; *) export PATH=\" + shell_quote(base + \"/bin\") + \":\\\"$\" + \"{PATH:-}\\\" ;; esac\\n\"","    write_file_atomic(environment, text, true)","    mut block := \"\\n# >>> Kennel PATH >>>\\n. \" + shell_quote(environment) + \"\\n# <<< Kennel PATH <<<\\n\"","    for name in [\".profile\", \".bash_profile\", \".bashrc\", \".zshrc\"] {","        mut path := user_home + \"/\" + name","        if global_link(path) { throw(\"Refusing to change symlinked shell profile; use --no-modify-path: \" + path) }","        mut old := \"\"; if path_exists(path) { old = read_file(path) }","        mut updated := old + block","        mut start := index_of(old, \"# >>> Kennel PATH >>>\")","        if start >= 0 {","            mut finish := index_of(old, \"# <<< Kennel PATH <<<\")","            if finish < start { throw(\"Malformed Kennel PATH profile block\") }","            mut end := finish + len(\"# <<< Kennel PATH <<<\")","            if start > 0 && substring(old, start - 1, start) == \"\\n\" { start = start - 1 }","            if end < len(old) && substring(old, end, end + 1) == \"\\n\" { end = end + 1 }","            updated = substring(old, 0, start) + block + substring(old, end, len(old))","        }","        if updated != old { write_file_atomic(path, updated, true) }","    }","}","export func bootstrap_main(argv) {","    if global_contains(argv, \"--help\") || global_contains(argv, \"-h\") { print(\"Install Kennel for macOS/Linux. Requires a Kujo runtime with native package primitives.\\nUsage: install.kujo [--source CHECKOUT | --version VERSION] [--home PATH] [--no-modify-path]\"); return }","    mut parsed := global_options(argv, [\"--source\", \"--version\", \"--home\"], [\"--no-modify-path\"])","    mut source := dict_get_or(parsed, \"--source\", \"\"); mut version := dict_get_or(parsed, \"--version\", \"\")","    if len(parsed[\"positional\"]) != 0 || source != \"\" && version != \"\" { throw(\"Use either --source or --version\") }","    mut runtime := global_runtime()","    mut base := global_home(dict_get_or(parsed, \"--home\", \"\"))","    env_set(\"KENNEL_HOME\", base)","    mut token := file_lock(base + \"/.tools.lock\", 180000)","    mut stage := \"\"","    try {","        mut clients := global_directory(base + \"/clients\"); mut bindir := global_directory(base + \"/bin\")","        mut launcher := bindir + \"/kennel\"","        mut expected := \"#!/bin/sh\\n# Kennel managed client\\nexport KENNEL_HOME=\" + shell_quote(base) + \"\\nexec \" + shell_quote(base + \"/client/bin/kennel\") + \" \\\"$@\\\"\\n\"","        if global_present(launcher) && global_owned(launcher, expected) == false { throw(\"Refusing to overwrite an existing kennel command: \" + launcher) }","        mut current := base + \"/client\"","        if global_present(current) && global_link(current) == false { throw(\"Existing client directory is not managed by this installer\") }","        mut modify := dict_get_or(parsed, \"--no-modify-path\", false) == false","        if modify {","            for name in [\".profile\", \".bash_profile\", \".bashrc\", \".zshrc\"] { if global_link(env(\"HOME\") + \"/\" + name) { throw(\"Shell profile is a symlink; use --no-modify-path\") } }","        }","        stage = create_temp_dir(clients, \"client-\")","        mut receipt := {}","        if source != \"\" { receipt = bootstrap_source(path_absolute(source), stage) } else { receipt = bootstrap_download(version, stage) }","        mut marker := stage + \"/scripts/bootstrap.json\"","        if path_is_file(marker) == false || dict_get_or(parse_json(read_file(marker)), \"installer_protocol\", 0) != 2 { throw(\"This historical Kennel release predates the native installer; use --source for review until the compatible release is published\") }","        for relative in [\"bin/kennel\", \"kennel.kujo\", \"scripts/tool_manager.kujo\", \"scripts/install.kujo\"] { if path_is_file(stage + \"/\" + relative) == false { throw(\"Incomplete Kennel client: \" + relative) } }","        io_set_permissions(stage + \"/bin/kennel\", 493)","        global_capture([runtime, \"run\", stage + \"/kennel.kujo\", \"--interpreter\", \"--isolated-imports\", \"--\", \"help\"], {\"KUJO_MODULE_PATH\": stage, \"KUJO_ISOLATED_IMPORTS\": \"1\"})","        write_file(stage + \"/install-receipt.json\", to_json(receipt) + \"\\n\")","        if modify { bootstrap_profiles(base, env(\"HOME\")) }","        if global_present(launcher) == false { write_file(launcher, expected); io_set_permissions(launcher, 493) }","        symlink_atomic(\"clients/\" + basename(stage), current)","        stage = \"\"","    } except err { if stage != \"\" { global_delete(stage) }; file_unlock(token); throw(err) }","    file_unlock(token)","    print(\"Kennel installed in \" + base)","    print(\"For this terminal: export PATH=\" + shell_quote(base + \"/bin\") + \":\\\"$PATH\\\"\")","    print(\"Next: kennel tool install shipcheck\")","    if source != \"\" { print(\"Review build installed; no official release was published.\") }","}",""],"src/global_common.kujo":["from src.utils import dict_get_or, shell_quote, ensure_dir","","export func global_absolute(path) {","    if starts_with(path, \"/\") == false { path = os_getcwd() + \"/\" + path }","    mut parts := []","    for part in split(path, \"/\") {","        if part == \"\" || part == \".\" { continue }","        if part == \"..\" { if len(parts) > 0 { parts = slice(parts, 0, len(parts) - 1) } } else { parts = push(parts, part) }","    }","    return \"/\" + join(parts, \"/\")","}","export func global_link(path) {","    try { return path_is_symlink(path) } except err {","        if global_contains(to_string(err), \"No such file\") { return false }","        throw(err)","    }","}","export func global_present(path) { return path_exists(path) || global_link(path) }","export func global_no_links(path) {","    mut current := global_absolute(path)","    while current != \"/\" && current != \".\" {","        if global_link(current) { throw(\"Path must not traverse symbolic links: \" + current) }","        mut next := dirname(current)","        if next == current { break }","        current = next","    }","}","export func global_directory(path) {","    global_no_links(path)","    if path_exists(path) == false { ensure_dir(path); io_set_permissions(path, 448) }","    mut info := io_file_metadata(path)","    if info[\"is_dir\"] == false || path_owned(path) == false || bit_and(info[\"mode\"], 18) != 0 {","        throw(\"Installation directories must be user-owned and not group/world writable: \" + path)","    }","    return path","}","export func global_home(raw) {","    if raw == \"\" { raw = env_or(\"KENNEL_HOME\", env_required(\"HOME\") + \"/.kennel\") }","    if starts_with(raw, \"~/\") { raw = env(\"HOME\") + substring(raw, 1, len(raw)) }","    return global_directory(global_absolute(raw))","}","export func global_delete(path) {","    if global_link(path) || path_is_file(path) { delete_file(path); return }","    if path_is_dir(path) { for item in list_dir(path) { global_delete(path + \"/\" + item) }; os_rmdir(path) }","}","export func global_capture(argv, extra) {","    mut result := spawn_process(argv, {\"timeout_ms\": 180000, \"max_output_bytes\": 8388608, \"env\": extra})","    if result.success == false || result.stdout_truncated || result.stderr_truncated { throw(\"Command failed: \" + join(argv, \" \") + \"\\n\" + result.stdout + result.stderr) }","    return result.stdout","}","export func global_which(name) {","    if index_of(name, \"/\") >= 0 { if path_is_file(name) { return path_absolute(name) }; return \"\" }","    for dir in split(env(\"PATH\"), \":\") {","        mut path := global_absolute(dir + \"/\" + name)","        if path_is_file(path) && bit_and(io_file_metadata(path)[\"mode\"], 73) != 0 { return path }","    }","    return \"\"","}","export func global_runtime() {","    mut found := global_which(env_or(\"KUJO_BIN\", \"kujo\"))","    if found == \"\" { throw(\"Install a compatible Kujo runtime first\") }","    return found","}","export func global_name(name) {","    if type(name) != \"string\" || len(name) == 0 || len(name) > 64 { return false }","    if name[0] < \"a\" || name[0] > \"z\" { return false }","    for ch in split(name, \"\") { if index_of(\"abcdefghijklmnopqrstuvwxyz0123456789_-\", ch) < 0 { return false } }","    return true","}","export func global_owned(path, expected) { return path_is_file(path) && global_link(path) == false && read_file(path) == expected }","export func global_options(argv, value_flags, boolean_flags) {","    mut result := {\"positional\": []}","    mut i := 0","    while i < len(argv) {","        mut arg := argv[i]","        mut equals := index_of(arg, \"=\")","        if starts_with(arg, \"--\") && equals > 2 {","            mut flag := substring(arg, 0, equals)","            if global_contains(value_flags, flag) == 0 { throw(\"Unknown option: \" + flag) }","            result[flag] = substring(arg, equals + 1, len(arg)); i = i + 1; continue","        }","        if global_contains(value_flags, arg) {","            i = i + 1","            if i >= len(argv) { throw(\"Missing value for \" + arg) }","            result[arg] = argv[i]","        } else if global_contains(boolean_flags, arg) { result[arg] = true","        } else if starts_with(arg, \"--\") { throw(\"Unknown option: \" + arg)","        } else { result[\"positional\"] = push(result[\"positional\"], arg) }","        i = i + 1","    }","    return result","}","","export func global_contains(collection, value) { if contains(collection, value) { return 1 }; return 0 }",""],"src/registry_archive.kujo":["from src.utils import ensure_dir","","func tar_text(data, start, count) {","\tend := start","\twhile end < start + count && data[end] != 0 {","\t\tif data[end] < 32 || data[end] > 126 {","\t\t\tthrow(\"Archive header contains nonportable characters\")","\t\t}","\t\tend = end + 1","\t}","\treturn decode_charset(slice(data, start, end), \"utf-8\", 512)","}","","func tar_octal(data, start, count) {","\ttext := trim(tar_text(data, start, count))","\tvalue := 0","\tfor ch in split(text, \"\") {","\t\tif ch == \"\" { continue }","\t\tif ch < \"0\" || ch > \"7\" {","\t\t\tthrow(\"Invalid archive numeric field\")","\t\t}","\t\tvalue = value * 8 + to_int(ch)","\t}","\treturn value","}","","export func archive_safe_path(name) {","\tif name == \"\" || len(name) > 240 || starts_with(name, \"/\") || index_of(name, \"\\\\\") >= 0 || index_of(name, \":\") >= 0 {","\t\tthrow(\"Unsafe archive path: \" + name)","\t}","\tfor part in split(name, \"/\") {","\t\tif part == \"\" || part == \".\" || part == \"..\" || ends_with(part, \".\") || ends_with(part, \" \") {","\t\t\tthrow(\"Unsafe archive path: \" + name)","\t\t}","\t\tbase := to_lower(split(part, \".\")[0])","\t\tif base == \"con\" || base == \"prn\" || base == \"aux\" || base == \"nul\" || starts_with(base, \"com\") && len(base) == 4 || starts_with(base, \"lpt\") && len(base) == 4 {","\t\t\tthrow(\"Nonportable archive path: \" + name)","\t\t}","\t}","\treturn name","}","","export func extract_registry_archive(blob, staging, expected_count) {","\tdata := gzip_decompress(blob, 67108864)","\tif len(data) < 1024 || len(data) % 512 != 0 {","\t\tthrow(\"Invalid USTAR archive length\")","\t}","\tentries := []","\tseen := {}","\tposition := 0","\tterminated := false","\tmanifest_found := false","\twhile position + 512 <= len(data) {","\t\t# Keep repeated indexed reads bounded to one header-sized buffer.","\t\theader := slice(data, position, position + 512)","\t\tif header[0] == 0 {","\t\t\tif len(data) - position < 1024 || len(data) - position > 10752 {","\t\t\t\tthrow(\"Invalid archive terminator length\")","\t\t\t}","\t\t\ttail := slice(data, position, len(data))","\t\t\ttail_position := 0","\t\t\twhile tail_position < len(tail) {","\t\t\t\tif tail[tail_position] != 0 {","\t\t\t\t\tthrow(\"Unexpected trailing archive content\")","\t\t\t\t}","\t\t\t\ttail_position = tail_position + 1","\t\t\t}","\t\t\tterminated = true","\t\t\tbreak","\t\t}","\t\tif tar_text(header, 257, 6) != \"ustar\" || tar_text(header, 263, 2) != \"00\" {","\t\t\tthrow(\"Only normalized USTAR packages are supported\")","\t\t}","\t\tcheck := 0","\t\ti := 0","\t\twhile i < 512 {","\t\t\tif i >= 148 && i < 156 {","\t\t\t\tcheck = check + 32","\t\t\t} else {","\t\t\t\tcheck = check + header[i]","\t\t\t}","\t\t\ti = i + 1","\t\t}","\t\tif check != tar_octal(header, 148, 8) {","\t\t\tthrow(\"Archive header checksum mismatch\")","\t\t}","\t\tkind := header[156]","\t\tif kind != 48 && kind != 0 {","\t\t\tthrow(\"Archive links, directories, devices and extension headers are forbidden\")","\t\t}","\t\tname := tar_text(header, 0, 100)","\t\tprefix := tar_text(header, 345, 155)","\t\tif prefix != \"\" {","\t\t\tname = prefix + \"/\" + name","\t\t}","\t\tarchive_safe_path(name)","\t\tif name == \"kennel.toml\" { manifest_found = true }","\t\tfolded_name := to_lower(name)","\t\tif has_key(seen, folded_name) {","\t\t\tthrow(\"Duplicate archive path\")","\t\t}","\t\tseen[folded_name] := true","\t\tmode := tar_octal(header, 100, 8)","\t\tif mode != 420 && mode != 493 {","\t\t\tthrow(\"Unsafe archive permissions\")","\t\t}","\t\tsize := tar_octal(header, 124, 12)","\t\tstart := position + 512","\t\tif size > 67108864 || start + size > len(data) || len(entries) >= 10000 {","\t\t\tthrow(\"Archive size or entry limit exceeded\")","\t\t}","\t\tentries = push(entries, {\"name\": name, \"start\": start, \"size\": size, \"mode\": mode})","\t\tposition = start + size","\t\tif size % 512 != 0 {","\t\t\tposition = position + 512 - size % 512","\t\t}","\t}","\tif terminated == false || len(entries) != expected_count || manifest_found == false {","\t\tthrow(\"Archive file count/manifest/termination mismatch\")","\t}","\t# Validate all headers before touching staging. Staging must be new.","\tif path_exists(staging) || (path_exists(staging) && path_is_symlink(staging)) {","\t\tthrow(\"Archive staging directory already exists\")","\t}","\tensure_dir(staging)","\tfor entry in entries {","\t\tpath := staging","\t\tparts := split(entry[\"name\"], \"/\")","\t\ti := 0","\t\twhile i < len(parts) - 1 {","\t\t\tpath = path + \"/\" + parts[i]","\t\t\tif (path_exists(path) && path_is_symlink(path)) || path_is_file(path) {","\t\t\t\tthrow(\"Archive path collision\")","\t\t\t}","\t\t\tensure_dir(path)","\t\t\ti = i + 1","\t\t}","\t\ttarget := staging + \"/\" + entry[\"name\"]","\t\tio_write_bytes(target, slice(data, entry[\"start\"], entry[\"start\"] + entry[\"size\"]))","\t\tio_set_permissions(target, entry[\"mode\"])","\t}","\treturn len(entries)","}",""],"src/registry_protocol.kujo":["from src.registry_transport import OFFICIAL_REGISTRY, registry_json, registry_blob","from src.semver import parse_semver_value, compare_semver, semver_satisfies_range","from src.utils import dict_get_or, validate_identifier","","export func registry_identity(value) {","\tparts := split(value, \"/\")","\tif starts_with(value, \"@\") {","\t\tif len(parts) != 2 {","\t\t\tthrow(\"Scoped package identity must be @scope/name\")","\t\t}","\t\tparts[0] = substring(parts[0], 1, len(parts[0]))","\t} else if len(parts) != 1 {","\t\tthrow(\"Invalid package identity\")","\t}","\tfor part in parts {","\t\tif part == \"\" || len(part) > 64 || to_lower(part) != part || validate_identifier(part, \"Package identity\")[\"ok\"] == false || index_of(part, \".\") >= 0 {","\t\t\tthrow(\"Invalid package identity: \" + value)","\t\t}","\t}","\treturn value","}","","export func registry_request(value) {","\tstart := 0","\tif starts_with(value, \"@\") {","\t\tstart = 1","\t}","\ti := start","\twhile i < len(value) {","\t\tif substring(value, i, i + 1) == \"@\" {","\t\t\treturn {\"name\": registry_identity(substring(value, 0, i)), \"selector\": substring(value, i + 1, len(value))}","\t\t}","\t\ti = i + 1","\t}","\treturn {\"name\": registry_identity(value), \"selector\": \"\"}","}","","export func registry_api_base(index_url) {","\tif starts_with(index_url, \"https://\") == false || ends_with(index_url, \"/api/v1/index.json\") == false {","\t\tthrow(\"Remote registry index must use HTTPS /api/v1/index.json\")","\t}","\treturn substring(index_url, 0, len(index_url) - len(\"index.json\"))","}","","func valid_digest(value) {","\tif type(value) != \"string\" || len(value) != 64 {","\t\treturn false","\t}","\tfor ch in split(value, \"\") {","\t\tif index_of(\"0123456789abcdef\", ch) < 0 {","\t\t\treturn false","\t\t}","\t}","\treturn true","}","","export func registry_valid_version(version) {","\tpieces := split(version, \"-\")","\tstable := parse_semver_value(pieces[0])","\tif stable[\"ok\"] == false || stable[\"normalized\"] != pieces[0] { return false }","\tif len(pieces) == 1 { return true }","\tpre := substring(version, len(pieces[0]) + 1, len(version))","\tfor token in split(pre, \".\") {","\t\tif token == \"\" { return false }","\t\tnumeric := true","\t\tfor ch in split(token, \"\") {","\t\t\tif ch == \"\" { continue }","\t\t\tif index_of(\"0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ-\", ch) < 0 { return false }","\t\t\tif ch < \"0\" || ch > \"9\" { numeric = false }","\t\t}","\t\tif numeric && len(token) > 1 && starts_with(token, \"0\") { return false }","\t}","\treturn true","}","","export func registry_validate_version(doc, identity, version_url) {","\tif type(doc) != \"dict\" || dict_get_or(doc, \"schema_version\", 0) != 1 {","\t\tthrow(\"Malformed package version schema\")","\t}","\tfor key in [\"package\", \"version\", \"description\", \"license\", \"released_at\", \"source_commit\", \"source_tag\", \"archive_url\", \"provenance_url\", \"checksum_url\", \"repository\", \"minimum_kujo_version\"] {","\t\tif type(dict_get_or(doc, key, null)) != \"string\" { throw(\"Missing or malformed release field: \" + key) }","\t}","\tif has_key(doc, \"scope\") == 0 || type(dict_get_or(doc, \"official\", null)) != \"bool\" { throw(\"Missing ownership fields\") }","\tfor key in [\"repository_id\", \"release_id\"] {","\t\tif type(dict_get_or(doc, key, null)) != \"int\" || doc[key] < 1 { throw(\"Invalid release identity: \" + key) }","\t}","\tname := registry_identity(identity)","\tactual := to_string(dict_get_or(doc, \"package\", \"\"))","\tscope := dict_get_or(doc, \"scope\", null)","\tif scope != null {","\t\tactual = \"@\" + to_string(scope) + \"/\" + actual","\t}","\tif actual != name {","\t\tthrow(\"Package identity mismatch\")","\t}","\tversion := to_string(dict_get_or(doc, \"version\", \"\"))","\tif registry_valid_version(version) == false || index_of(version, \"/\") >= 0 || ends_with(version_url, \"/\" + identity + \"/\" + version + \".json\") == false {","\t\tthrow(\"Package version URL mismatch\")","\t}","\towner := dict_get_or(doc, \"owner\", {})","\tif type(owner) != \"dict\" || (dict_get_or(owner, \"type\", \"\") != \"user\" && dict_get_or(owner, \"type\", \"\") != \"organization\") || type(dict_get_or(owner, \"id\", null)) != \"string\" || owner[\"id\"] == \"\" { throw(\"Malformed package owner\") }","\tfor ch in split(doc[\"source_commit\"], \"\") {","\t\tif ch != \"\" && index_of(\"0123456789abcdef\", ch) < 0 { throw(\"Malformed source commit\") }","\t}","\tif scope == null && (dict_get_or(doc, \"official\", false) != true || dict_get_or(owner, \"type\", \"\") != \"organization\" || dict_get_or(owner, \"id\", \"\") != \"kujolang\") {","\t\tthrow(\"Unscoped packages are reserved for official Kujo ownership\")","\t}","\tif scope != null && dict_get_or(doc, \"official\", false) {","\t\tthrow(\"Scoped packages cannot claim reserved official identity\")","\t}","\tfor key in [\"archive_sha256\", \"provenance_sha256\"] {","\t\tif valid_digest(dict_get_or(doc, key, \"\")) == false {","\t\t\tthrow(\"Malformed package digest: \" + key)","\t\t}","\t}","\tif type(dict_get_or(doc, \"archive_size\", \"\")) != \"int\" || doc[\"archive_size\"] <= 0 || doc[\"archive_size\"] > 8388608 || type(dict_get_or(doc, \"file_count\", \"\")) != \"int\" || doc[\"file_count\"] < 1 || doc[\"file_count\"] > 10000 {","\t\tthrow(\"Invalid package size/file count\")","\t}","\tif len(to_string(dict_get_or(doc, \"source_commit\", \"\"))) != 40 || type(dict_get_or(doc, \"dependencies\", \"\")) != \"dict\" {","\t\tthrow(\"Malformed source commit/dependencies\")","\t}","\tmarker := index_of(version_url, \"/api/v1/packages/\")","\tif marker < 0 {","\t\tthrow(\"Invalid version metadata URL\")","\t}","\torigin := substring(version_url, 0, marker)","\tprefix := origin + \"/packages/\" + identity + \"/\" + version + \"/\"","\tfor pair in [[\"archive_url\", \"package.tar.gz\"], [\"provenance_url\", \"provenance.json\"], [\"checksum_url\", \"checksums.txt\"]] {","\t\tif dict_get_or(doc, pair[0], \"\") != prefix + pair[1] {","\t\t\tthrow(\"Artifact URL is outside immutable package namespace\")","\t\t}","\t}","\treturn doc","}","","export func registry_resolve_name(index_url, request_value, ranges) {","\trequest := registry_request(request_value)","\tidentity := request[\"name\"]","\tbase := registry_api_base(index_url)","\tmetadata := registry_json(base + \"packages/\" + identity + \".json\")","\tmetadata_identity := to_string(dict_get_or(metadata, \"name\", \"\"))","\tif dict_get_or(metadata, \"scope\", null) != null {","\t\tmetadata_identity = \"@\" + to_string(metadata[\"scope\"]) + \"/\" + metadata_identity","\t}","\tif metadata_identity != identity || type(dict_get_or(metadata, \"versions\", \"\")) != \"array\" {","\t\tthrow(\"Malformed package metadata\")","\t}","\tselector := request[\"selector\"]","\tbest := \"\"","\tbest_parsed := {}","\tfor entry in metadata[\"versions\"] {","\t\tversion := to_string(dict_get_or(entry, \"version\", \"\"))","\t\tif registry_valid_version(version) == false { throw(\"Malformed registry SemVer\") }","\t\tif dict_get_or(entry, \"yanked\", false) {","\t\t\tcontinue","\t\t}","\t\tif selector != \"\" && version == selector {","\t\t\tbest = version","\t\t\tbreak","\t\t}","\t\tparsed := parse_semver_value(version)","\t\tif parsed[\"ok\"] && (selector == \"\" || ranges && semver_satisfies_range(parsed, selector)) {","\t\t\tif best == \"\" || compare_semver(parsed, best_parsed) > 0 {","\t\t\t\tbest = version","\t\t\t\tbest_parsed = parsed","\t\t\t}","\t\t}","\t}","\tif best == \"\" {","\t\tthrow(\"No available package version matches \" + request_value)","\t}","\turl := base + \"packages/\" + identity + \"/\" + best + \".json\"","\tdoc := registry_validate_version(registry_json(url), identity, url)","\treturn {\"ok\": true, \"index_path\": index_url, \"parsed\": {\"ok\": true, \"kind\": \"registry\", \"name\": identity, \"source\": \"registry:\" + url, \"url\": url, \"requested\": best, \"requested_kind\": \"version\", \"checksum\": \"sha256:\" + doc[\"archive_sha256\"]}}","}","","export func registry_resolve_spec(name, spec) {","\turl := spec[\"url\"]","\tidentity := name","\tmarker := index_of(url, \"/api/v1/packages/\")","\tif marker < 0 {","\t\tthrow(\"Invalid registry version source\")","\t}","\tbody := substring(url, marker + len(\"/api/v1/packages/\"), len(url))","\tparts := split(body, \"/\")","\tif len(parts) == 2 {","\t\tidentity = parts[0]","\t} else if len(parts) == 3 {","\t\tidentity = parts[0] + \"/\" + parts[1]","\t} else {","\t\tthrow(\"Invalid registry package source\")","\t}","\tdoc := registry_validate_version(registry_json(url), identity, url)","\tif dict_get_or(spec, \"checksum\", \"\") != \"\" && spec[\"checksum\"] != \"sha256:\" + doc[\"archive_sha256\"] {","\t\tthrow(\"Package checksum changed after resolution\")","\t}","\treturn {\"name\": name, \"kind\": \"registry\", \"source\": \"registry:\" + url, \"url\": url, \"requested\": doc[\"version\"], \"requested_kind\": \"version\", \"resolved_ref\": doc[\"version\"], \"resolved_commit\": doc[\"source_commit\"], \"path\": \"\", \"checksum\": \"sha256:\" + doc[\"archive_sha256\"], \"registry\": substring(url, 0, marker) + \"/api/v1/index.json\", \"registry_manifest\": doc, \"package_identity\": identity, \"provenance_status\": \"registry-statement-verified\"}","}","","export func registry_verify_provenance(doc) {","\tdata := registry_blob(doc[\"provenance_url\"], doc[\"provenance_sha256\"], 1048576)","\tprovenance := parse_json(decode_charset(data, \"utf-8\", 1048576))","\tif type(provenance) != \"dict\" || dict_get_or(provenance, \"schema_version\", 0) != 1 {","\t\tthrow(\"Malformed package provenance\")","\t}","\tfor key in [\"package\", \"version\", \"archive_sha256\", \"source_commit\", \"source_tag\", \"repository\", \"repository_id\", \"release_id\"] {","\t\tif dict_get_or(provenance, key, null) != dict_get_or(doc, key, \"\") {","\t\t\tthrow(\"Package provenance mismatch: \" + key)","\t\t}","\t}","\tif doc[\"official\"] && starts_with(to_string(dict_get_or(provenance, \"repository\", \"\")), \"kujolang/\") == false {","\t\tthrow(\"Official package requires Kujo repository provenance\")","\t}","\tfor key in [\"workflow_run\", \"workflow_ref\", \"workflow_sha\", \"published_at\"] {","\t\tif to_string(dict_get_or(provenance, key, \"\")) == \"\" {","\t\t\tthrow(\"Missing publishing workflow provenance: \" + key)","\t\t}","\t}","\treturn true","}",""],"src/registry_transport.kujo":["from src.utils import dict_get_or, ensure_dir","","export OFFICIAL_REGISTRY := \"https://kennel.kujolang.ai/api/v1/index.json\"","export MAX_ARCHIVE_BYTES := 8388608","","export func registry_get(url, maximum) {","\tif starts_with(url, \"https://\") == false || index_of(url, \"#\") >= 0 {","\t\tthrow(\"Registry transport requires an HTTPS URL without credentials or fragments\")","\t}","\tauthority := split(substring(url, len(\"https://\"), len(url)), \"/\")[0]","\tif authority == \"\" || index_of(authority, \"@\") >= 0 {","\t\tthrow(\"Registry transport forbids URL credentials\")","\t}","\tresult := http_request(url, {\"method\": \"GET\", \"timeout\": 30, \"max_response_bytes\": maximum, \"redirects\": \"none\", \"headers\": {\"Accept\": \"application/json, application/octet-stream\", \"User-Agent\": \"Kennel/registry-v1\"}})","\tmatch result {","\t\tcase Result::Ok(response): {","\t\t\tif response[\"status\"] != 200 {","\t\t\t\tthrow(\"Registry request failed (HTTP \" + to_string(response[\"status\"]) + \"): \" + url)","\t\t\t}","\t\t\treturn response","\t\t}","\t\tcase Result::Err(message): {","\t\t\tthrow(\"Registry network failure: \" + to_string(message))","\t\t}","\t}","\tthrow(\"Invalid registry response\")","}","","export func registry_json(url) {","\tresponse := registry_get(url, 1048576)","\tdoc := parse_json(response[\"body\"])","\tif type(doc) != \"dict\" || dict_get_or(doc, \"schema_version\", 0) != 1 {","\t\tthrow(\"Unsupported or malformed registry schema: \" + url)","\t}","\treturn doc","}","","export func registry_cache_root() {","\thome := env(\"HOME\")","\tif trim(home) == \"\" {","\t\tthrow(\"HOME is required for the Kennel artifact cache\")","\t}","\tbase := trim(env(\"KENNEL_HOME\"))","\tif base == \"\" {","\t\tbase = home + \"/.kennel\"","\t}","\tif starts_with(base, \"/\") == false {","\t\tthrow(\"KENNEL_HOME must be an absolute directory\")","\t}","\troot := base + \"/cache/sha256\"","\tfor part in [base, base + \"/cache\", root] {","\t\tif (path_exists(part) && path_is_symlink(part)) {","\t\t\tthrow(\"Refusing symlinked Kennel cache directory\")","\t\t}","\t\tensure_dir(part)","\t}","\treturn root","}","","export func registry_blob(url, digest, maximum) {","\tif len(digest) != 64 {","\t\tthrow(\"Invalid archive SHA-256\")","\t}","\tfor ch in split(digest, \"\") {","\t\tif index_of(\"0123456789abcdef\", ch) < 0 {","\t\t\tthrow(\"Invalid archive SHA-256\")","\t\t}","\t}","\tcache := registry_cache_root() + \"/\" + digest","\tif file_exists(cache) && path_is_symlink(cache) == false && file_size(cache) <= maximum {","\t\tcached := io_read_bytes(cache, maximum)","\t\tif sha256(cached) == digest {","\t\t\treturn cached","\t\t}","\t}","\tresponse := registry_get(url, maximum)","\tdata := response[\"_body_bytes\"]","\tif sha256(data) != digest {","\t\tthrow(\"Registry checksum mismatch: \" + url)","\t}","\t# Atomic replacement never follows an existing cache-file symlink.","\twrite_file_atomic(cache, data, true)","\treturn data","}",""],"src/semver.kujo":["func strip_leading_v(value) {","\ttext := trim(to_string(value))","\tif starts_with(text, \"v\") || starts_with(text, \"V\") {","\t\treturn substring(text, 1, len(text))","\t}","\treturn text","}","","func is_digits(value) {","\ttext := trim(to_string(value))","\tif text == \"\" {","\t\treturn false","\t}","\tidx := 0","\twhile idx < len(text) {","\t\tch := substring(text, idx, idx + 1)","\t\tif ch < \"0\" || ch > \"9\" {","\t\t\treturn false","\t\t}","\t\tidx = idx + 1","\t}","\treturn true","}","","func normalize_numeric_string(value) {","\ttext := trim(to_string(value))","\tif text == \"\" {","\t\treturn \"0\"","\t}","\tidx := 0","\twhile idx < len(text) - 1 && substring(text, idx, idx + 1) == \"0\" {","\t\tidx = idx + 1","\t}","\treturn substring(text, idx, len(text))","}","","func parse_semver_value(value) {","\ttext := strip_leading_v(value)","\tparts := split(text, \".\")","\tif len(parts) != 3 {","\t\treturn {","\t\t\t\"ok\": false","\t\t}","\t}","\tmajor := normalize_numeric_string(parts[0])","\tminor := normalize_numeric_string(parts[1])","\tpatch := normalize_numeric_string(parts[2])","\tif is_digits(major) == false || is_digits(minor) == false || is_digits(patch) == false {","\t\treturn {","\t\t\t\"ok\": false","\t\t}","\t}","\treturn {","\t\t\"ok\": true,","\t\t\"major\": major,","\t\t\"minor\": minor,","\t\t\"patch\": patch,","\t\t\"normalized\": major + \".\" + minor + \".\" + patch","\t}","}","","func compare_numeric_segments(left_value, right_value) {","\tleft := normalize_numeric_string(left_value)","\tright := normalize_numeric_string(right_value)","\tif len(left) > len(right) {","\t\treturn 1","\t}","\tif len(left) < len(right) {","\t\treturn -1","\t}","\tif left > right {","\t\treturn 1","\t}","\tif left < right {","\t\treturn -1","\t}","\treturn 0","}","","func compare_semver(left_version, right_version) {","\tmajor_compare := compare_numeric_segments(left_version[\"major\"], right_version[\"major\"])","\tif major_compare != 0 {","\t\treturn major_compare","\t}","\tminor_compare := compare_numeric_segments(left_version[\"minor\"], right_version[\"minor\"])","\tif minor_compare != 0 {","\t\treturn minor_compare","\t}","\treturn compare_numeric_segments(left_version[\"patch\"], right_version[\"patch\"])","}","","func semver_range_tokens(range_expr) {","\traw := replace(trim(to_string(range_expr)), \",\", \" \")","\tif raw == \"\" {","\t\treturn []","\t}","\tparts := split(raw, \" \")","\ttokens := []","\tfor part in parts {","\t\ttoken := trim(to_string(part))","\t\tif token != \"\" {","\t\t\ttokens := push(tokens, token)","\t\t}","\t}","\treturn tokens","}","","func semver_satisfies_token(version_obj, token_value) {","\ttoken := trim(to_string(token_value))","\tif token == \"\" || token == \"*\" {","\t\treturn true","\t}","\toperator := \"=\"","\toperand := token","\tif starts_with(token, \">=\") || starts_with(token, \"<=\") {","\t\toperator = substring(token, 0, 2)","\t\toperand = substring(token, 2, len(token))","\t} else if starts_with(token, \">\") || starts_with(token, \"<\") || starts_with(token, \"=\") || starts_with(token, \"^\") || starts_with(token, \"~\") {","\t\toperator = substring(token, 0, 1)","\t\toperand = substring(token, 1, len(token))","\t}","\tbase_version := parse_semver_value(operand)","\tif base_version[\"ok\"] == false {","\t\treturn false","\t}","\tcmp := compare_semver(version_obj, base_version)","\tif operator == \">=\" {","\t\treturn cmp >= 0","\t}","\tif operator == \">\" {","\t\treturn cmp > 0","\t}","\tif operator == \"<=\" {","\t\treturn cmp <= 0","\t}","\tif operator == \"<\" {","\t\treturn cmp < 0","\t}","\tif operator == \"~\" {","\t\tif compare_numeric_segments(version_obj[\"major\"], base_version[\"major\"]) != 0 {","\t\t\treturn false","\t\t}","\t\tif compare_numeric_segments(version_obj[\"minor\"], base_version[\"minor\"]) != 0 {","\t\t\treturn false","\t\t}","\t\treturn cmp >= 0","\t}","\tif operator == \"^\" {","\t\tif compare_numeric_segments(base_version[\"major\"], \"0\") == 0 {","\t\t\tif compare_numeric_segments(base_version[\"minor\"], \"0\") == 0 {","\t\t\t\tif compare_numeric_segments(version_obj[\"major\"], \"0\") != 0 {","\t\t\t\t\treturn false","\t\t\t\t}","\t\t\t\tif compare_numeric_segments(version_obj[\"minor\"], \"0\") != 0 {","\t\t\t\t\treturn false","\t\t\t\t}","\t\t\t\treturn cmp >= 0","\t\t\t}","\t\t\tif compare_numeric_segments(version_obj[\"major\"], \"0\") != 0 {","\t\t\t\treturn false","\t\t\t}","\t\t\tif compare_numeric_segments(version_obj[\"minor\"], base_version[\"minor\"]) != 0 {","\t\t\t\treturn false","\t\t\t}","\t\t\treturn cmp >= 0","\t\t}","\t\tif compare_numeric_segments(version_obj[\"major\"], base_version[\"major\"]) != 0 {","\t\t\treturn false","\t\t}","\t\treturn cmp >= 0","\t}","\treturn cmp == 0","}","","func semver_satisfies_range(version_obj, range_expr) {","\ttokens := semver_range_tokens(range_expr)","\tif len(tokens) == 0 {","\t\treturn false","\t}","\tfor token in tokens {","\t\tif semver_satisfies_token(version_obj, token) == false {","\t\t\treturn false","\t\t}","\t}","\treturn true","}","","","export parse_semver_value := parse_semver_value","export compare_semver := compare_semver","export semver_satisfies_range := semver_satisfies_range",""],"src/utils.kujo":["func dict_get_or(obj, lookup_key, default_value) {","\tif type(obj) != \"dict\" {","\t\treturn default_value","\t}","\tif has_key(obj, lookup_key) {","\t\treturn obj[lookup_key]","\t}","\treturn default_value","}","","func clone_dict(values) {","\tif type(values) != \"dict\" {","\t\treturn {}","\t}","\tcloned := {}","\tfor key in keys(values) {","\t\tcloned[key] := values[key]","\t}","\treturn cloned","}","","func clone_array(values) {","\tif type(values) != \"array\" {","\t\treturn []","\t}","\tcloned := []","\tfor value in values {","\t\tcloned := push(cloned, value)","\t}","\treturn cloned","}","","func ensure_dir(path) {","\tif trim(path) == \"\" {","\t\treturn","\t}","\tif path_exists(path) {","\t\treturn","\t}","\ttry {","\t\tcreate_dir(path)","\t} except err {","\t\t# Directory may be created concurrently.","\t}","}","","func write_text_atomic(path, content) {","\twrite_file_atomic(path, to_string(content), true)","\treturn path","}","","func path_basename(path) {","\tbase := basename(path)","\tif ends_with(base, \"/\") {","\t\tbase := substring(base, 0, len(base) - 1)","\t}","\treturn base","}","","func shell_quote(value) {","\ttext := to_string(value)","\treturn \"'\" + replace(text, \"'\", \"'\\\"'\\\"'\") + \"'\"","}","","func run_shell(command) {","\tresult := execute_status(command, {","\t\t\"timeout_ms\": 240000,","\t\t\"max_output_bytes\": 1024 * 1024 * 8","\t})","\treturn result","}","","func command_ok(result) {","\treturn result.success && result.exitcode == 0","}","","func trim_or(value, fallback) {","\tif type(value) == \"null\" {","\t\treturn fallback","\t}","\ttext := trim(to_string(value))","\tif text == \"\" {","\t\treturn fallback","\t}","\treturn text","}","","func starts_with_any(value, needles) {","\tfor needle in needles {","\t\tif starts_with(value, needle) {","\t\t\treturn true","\t\t}","\t}","\treturn false","}","","func is_hex_lower(text) {","\tif trim(text) == \"\" {","\t\treturn false","\t}","\tallowed := \"0123456789abcdef\"","\ti := 0","\twhile i < len(text) {","\t\tch := to_lower(substring(text, i, i + 1))","\t\tif index_of(allowed, ch) < 0 {","\t\t\treturn false","\t\t}","\t\ti := i + 1","\t}","\treturn true","}","","func is_valid_identifier(value) {","\ttext := trim(to_string(value))","\tif text == \"\" {","\t\treturn false","\t}","\tallowed := \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-\"","\ti := 0","\twhile i < len(text) {","\t\tch := substring(text, i, i + 1)","\t\tif index_of(allowed, ch) < 0 {","\t\t\treturn false","\t\t}","\t\ti := i + 1","\t}","\treturn true","}","","func validate_identifier(value, label) {","\ttext := trim(to_string(value))","\tif is_valid_identifier(text) {","\t\treturn {","\t\t\t\"ok\": true,","\t\t\t\"value\": text","\t\t}","\t}","\treturn {","\t\t\"ok\": false,","\t\t\"error\": label + \" must contain only letters, numbers, hyphen, or underscore.\",","\t\t\"value\": text","\t}","}","","func is_base64_text(value) {","\ttext := trim(to_string(value))","\tif text == \"\" {","\t\treturn false","\t}","\tallowed := \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789+/=\"","\ti := 0","\twhile i < len(text) {","\t\tch := substring(text, i, i + 1)","\t\tif index_of(allowed, ch) < 0 {","\t\t\treturn false","\t\t}","\t\ti := i + 1","\t}","\tif len(text) % 4 != 0 {","\t\treturn false","\t}","\treturn true","}","","func is_safe_signing_key(value) {","\ttext := trim(to_string(value))","\tif text == \"\" {","\t\treturn false","\t}","\tallowed := \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._:-/\"","\ti := 0","\twhile i < len(text) {","\t\tch := substring(text, i, i + 1)","\t\tif index_of(allowed, ch) < 0 {","\t\t\treturn false","\t\t}","\t\ti := i + 1","\t}","\treturn true","}","","func parse_checksum(value) {","\ttext := trim(to_string(value))","\tparts := split(text, \":\")","\tif len(parts) != 2 {","\t\treturn {","\t\t\t\"ok\": false,","\t\t\t\"error\": \"Checksum must use canonical algorithm:digest format.\"","\t\t}","\t}","\talgorithm := to_lower(trim(parts[0]))","\tdigest := to_lower(trim(parts[1]))","\tif algorithm != \"sha256\" && algorithm != \"sha512\" {","\t\treturn {","\t\t\t\"ok\": false,","\t\t\t\"error\": \"Checksum algorithm must be sha256 or sha512.\"","\t\t}","\t}","\tif is_hex_lower(digest) == false {","\t\treturn {","\t\t\t\"ok\": false,","\t\t\t\"error\": \"Checksum digest must be lowercase hexadecimal.\"","\t\t}","\t}","\tif algorithm == \"sha256\" && len(digest) != 64 {","\t\treturn {","\t\t\t\"ok\": false,","\t\t\t\"error\": \"sha256 checksum digest must be 64 hex characters.\"","\t\t}","\t}","\tif algorithm == \"sha512\" && len(digest) != 128 {","\t\treturn {","\t\t\t\"ok\": false,","\t\t\t\"error\": \"sha512 checksum digest must be 128 hex characters.\"","\t\t}","\t}","\treturn {","\t\t\"ok\": true,","\t\t\"algorithm\": algorithm,","\t\t\"digest\": digest,","\t\t\"normalized\": algorithm + \":\" + digest","\t}","}","","func is_semver_core(value) {","\tsemver_text := trim(to_string(value))","\tif starts_with(semver_text, \"v\") || starts_with(semver_text, \"V\") {","\t\tsemver_text = substring(semver_text, 1, len(semver_text))","\t}","\tparts := split(semver_text, \".\")","\tif len(parts) != 3 {","\t\treturn false","\t}","\tfor part in parts {","\t\tif part == \"\" {","\t\t\treturn false","\t\t}","\t\ti := 0","\t\twhile i < len(part) {","\t\t\tch := substring(part, i, i + 1)","\t\t\tif ch < \"0\" || ch > \"9\" {","\t\t\t\treturn false","\t\t\t}","\t\t\ti = i + 1","\t\t}","\t}","\treturn true","}","","func parse_ref_kind(value) {","\ttext := trim(to_string(value))","\tif text == \"\" {","\t\treturn {","\t\t\t\"kind\": \"none\",","\t\t\t\"value\": \"\"","\t\t}","\t}","\tif starts_with(text, \"^\") || starts_with(text, \"~\") || starts_with(text, \">\") || starts_with(text, \"<\") || starts_with(text, \"=\") || index_of(text, \" \") >= 0 || index_of(text, \",\") >= 0 || index_of(text, \"*\") >= 0 {","\t\treturn {","\t\t\t\"kind\": \"range\",","\t\t\t\"value\": text","\t\t}","\t}","\tif len(text) >= 7 && is_hex_lower(text) {","\t\treturn {","\t\t\t\"kind\": \"commit\",","\t\t\t\"value\": text","\t\t}","\t}","\tif is_semver_core(text) {","\t\treturn {","\t\t\t\"kind\": \"version\",","\t\t\t\"value\": text","\t\t}","\t}","\treturn {","\t\t\"kind\": \"ref\",","\t\t\"value\": text","\t}","}","","func to_pretty_json(value) {","\treturn to_json(value)","}","","func is_truthy_string(value) {","\ttext := to_lower(trim(to_string(value)))","\treturn text == \"1\" || text == \"true\" || text == \"yes\" || text == \"y\"","}","","func insert_sorted_by_name(items, item) {","\tinserted := false","\tresult := []","\titem_name := to_lower(to_string(dict_get_or(item, \"name\", \"\")))","\tfor existing in items {","\t\texisting_name := to_lower(to_string(dict_get_or(existing, \"name\", \"\")))","\t\tif inserted == false && item_name < existing_name {","\t\t\tresult := push(result, item)","\t\t\tinserted := true","\t\t}","\t\tresult := push(result, existing)","\t}","\tif inserted == false {","\t\tresult := push(result, item)","\t}","\treturn result","}","","export dict_get_or := dict_get_or","export clone_dict := clone_dict","export clone_array := clone_array","export ensure_dir := ensure_dir","export write_text_atomic := write_text_atomic","export path_basename := path_basename","export shell_quote := shell_quote","export run_shell := run_shell","export command_ok := command_ok","export trim_or := trim_or","export starts_with_any := starts_with_any","export is_hex_lower := is_hex_lower","export is_valid_identifier := is_valid_identifier","export validate_identifier := validate_identifier","export is_base64_text := is_base64_text","export is_safe_signing_key := is_safe_signing_key","export parse_checksum := parse_checksum","export parse_ref_kind := parse_ref_kind","export to_pretty_json := to_pretty_json","export is_truthy_string := is_truthy_string","export insert_sorted_by_name := insert_sorted_by_name",""]}
installer_workspace := create_temp_dir(path_absolute("/tmp"), "kennel-installer-modules-")
func installer_cleanup(directory, modules) {
    for filename in keys(modules) { if path_is_file(directory + "/" + filename) { delete_file(directory + "/" + filename) } }
    for folder in ["src", "scripts"] { if path_is_dir(directory + "/" + folder) { os_rmdir(directory + "/" + folder) } }
    os_rmdir(directory)
}
try {
    create_dir(installer_workspace + "/src"); create_dir(installer_workspace + "/scripts")
    for filename in keys(installer_modules) { write_file(installer_workspace + "/" + filename, join(installer_modules[filename], "\n")) }
    installer_runtime := env_or("KUJO_BIN", "kujo")
    installer_result := spawn_process(concat([installer_runtime, "run", installer_workspace + "/scripts/install.kujo", "--interpreter", "--isolated-imports", "--"], args()), {"env": {"KUJO_MODULE_PATH": installer_workspace, "KUJO_ISOLATED_IMPORTS": "1"}, "timeout_ms": 300000, "max_output_bytes": 1048576})
    if installer_result.stdout != "" { print(installer_result.stdout) }
    if installer_result.stderr != "" { print(installer_result.stderr) }
    installer_cleanup(installer_workspace, installer_modules)
    if installer_result.timed_out || installer_result.stdout_truncated || installer_result.stderr_truncated { print("Kennel installer exceeded its execution bounds"); exit(1) }
    exit(installer_result.exitcode)
} except err { installer_cleanup(installer_workspace, installer_modules); print("Kennel installer: " + to_string(err)); exit(1) }
